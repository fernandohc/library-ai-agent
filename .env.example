# OpenAI API key used by the LangChain agents
OPENAI_API_KEY=your_openai_api_key_here

# Connection used by scripts executed on your host machine (e.g. seed.py)
MONGODB_URI=mongodb://library_app:library_app_password@localhost:27017/library_ai?authSource=library_ai
MONGODB_DATABASE=library_ai

# Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
